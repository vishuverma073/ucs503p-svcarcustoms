# ─────────────────────────────────────────────────────────────────────────────
# svcar-india (storefront) — environment variables
#
# Local dev: copy to `.env.local` and edit.
# Vercel:    set these in Project → Settings → Environment Variables
#            (this file is only a template — .env.local is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ─── MODE A · MOCK PREVIEW (no backend/DB needed — good for a Vercel demo) ───
# MSW serves fake products/cart/checkout entirely in the browser + SSR. Deploy
# this way to click through the whole storefront before the API is live.
NEXT_PUBLIC_USE_MOCKS=true
# Mock the payment sheet too (no real PayU redirect):
NEXT_PUBLIC_MOCK_PAYMENTS=true

# ─── MODE B · REAL BACKEND (production launch) ───────────────────────────────
# Flip mocks OFF and point at the deployed API (Railway/Render/etc.). Do NOT
# ship MSW to a real production deploy — keep NEXT_PUBLIC_USE_MOCKS unset/false.
# NEXT_PUBLIC_USE_MOCKS=false
# NEXT_PUBLIC_MOCK_PAYMENTS=false
# NEXT_PUBLIC_API_URL=https://api.svcarcustoms.com

# ─── Brand / SEO (safe to set in every environment) ──────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.svcarcustoms.com
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/svcarcustoms/

# ─── Marketing analytics & pixels (all OPTIONAL — inert until set) ───────────
# Paste these once you create the accounts; no code change needed after.
# Google Analytics 4 measurement id:
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Ads tag id (+ its Purchase conversion label, "AW-XXX/label" tail):
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=abcdEFGhiJKlmno
# Meta (Facebook/Instagram) Pixel id (numeric):
# NEXT_PUBLIC_META_PIXEL_ID=1234567890
# Google Search Console meta-tag verification token:
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional ────────────────────────────────────────────────────────────────
# Same-origin API proxy for LAN/phone testing (Next rewrites /svcar-api/* → API):
# NEXT_PUBLIC_USE_API_PROXY=true
# API_PROXY_TARGET=http://127.0.0.1:8787
# Sentry (client error tracking; inert when unset):
# NEXT_PUBLIC_SENTRY_DSN=
